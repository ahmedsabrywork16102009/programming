{
  "manifest_version": 3,
  "name": "Nahgelazhar helper",
  "short_name": "Nahgelazhar",
  "version": "3.0",
  "description": "Subject and lecture view for the Nahgelazhar platform.",
  "permissions": ["storage"],
  "host_permissions": ["https://nahgelazhar.com/*"],
  "icons": {
    "16": "assets/icons/icon.png",
    "48": "assets/icons/icon.png",
    "128": "assets/icons/icon.png"
  },
  "action": {
    "default_title": "Nahgelazhar helper",
    "default_popup": "src/popup/popup.html",
    "default_icon": "assets/icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://nahgelazhar.com/*"],
      "js": ["src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://nahgelazhar.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ]
}